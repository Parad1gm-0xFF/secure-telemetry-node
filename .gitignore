# --- Rust / Cargo ---
# `target/` : artefacts de build, jamais committés.
/target
# `Cargo.lock` EST committé pour un binaire Rust (reproductibilité des builds).

# --- QEMU usermode téléchargé (10 Mo) : récupéré à la volée par run-qemu.sh ---
/tools/

# --- Yocto / bitbake ---
build/
tmp/
*.pyc

# --- RPM : produits par la CI (artefacts GitHub Actions) ---
# On ne commit plus les binaires ; le spec redpesk et la CI les génèrent.
*.rpm
dist/
.rpmbuild/

# --- Module noyau : artefacts de compilation locaux ---
kernel/*.o
kernel/*.ko
kernel/*.mod
kernel/*.mod.c
kernel/*.mod.o
kernel/*.symvers
kernel/overlays/*.dtbo
kernel/overlays/*.dtb
# --- fichier de test du sandbox (self-test SIGSYS) ---
stn-self-test.tmp
