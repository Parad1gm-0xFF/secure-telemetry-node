# --- Rust / Cargo ---
# `target/` : artefacts de build, jamais committés.
/target
# `Cargo.lock` EST committé pour un binaire Rust (reproductibilité des builds).

# --- QEMU usermode téléchargé (10 Mo) : récupéré à la volée par run-qemu.sh ---
/tools/

# --- Yocto / bitbake ---
build/
tmp/
*.pyc

# --- RPM : l'artefact buildé est livré dans dist/ (committé comme preuve) ---
# .rpm générés hors du dossier dist/ sont ignorés (ex: arbre rpmbuild local).
*.rpm
!/dist/*.rpm

# --- arbre rpmbuild local ---
.rpmbuild/